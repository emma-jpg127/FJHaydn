#!/bin/bash

######################################################################
###  Iniciar
######################################################################
fnc_enrutar_iniciar() {
	echo fnc_enrutar_iniciar
	
	ip a a 10.0.1.1/24 dev enp1s0f0
	ip l s dev enp1s0f0 up
	sysctl -w net.ipv4.ip_forward=1
	iptables -t nat -A POSTROUTING -o enp6s0 -j MASQUERADE
	
}

######################################################################
###  Aturar
######################################################################
fnc_enrutar_aturar() {
	echo fnc_enrutar_aturar
	
	iptables -t nat -D POSTROUTING -o enp6s0 -j MASQUERADE
	sysctl -w net.ipv4.ip_forward=0
	ip a D 10.0.1.1/24 dev enp1s0f0
	ip l s dev enp1s0f0 down
}
